# Public values bundled into the Vite client
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_API_KEY=your-public-api-key
VITE_CLOUDINARY_UPLOAD_PRESET=foliolabz_signed_intake
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Netlify Function values. API secret, Turnstile secret, and token secret are private.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-public-api-key
CLOUDINARY_UPLOAD_PRESET=foliolabz_signed_intake
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
UPLOAD_TOKEN_SECRET=generate-a-long-random-value

# Optional: days before an unsubmitted upload is deleted (default 7)
CLOUDINARY_ABANDONED_DAYS=7